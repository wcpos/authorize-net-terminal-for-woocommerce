{
    "name": "wcpos/authorize-net-terminal-for-woocommerce",
    "description": "Authorize.net Tap to Pay for WooCommerce POS.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=7.4",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "WCPOS\\WooCommercePOS\\AuthorizeNetTerminal\\": "includes/"
        }
    },
    "config": {
        "platform": {
            "php": "7.4"
        }
    },
    "scripts": {
        "test": "php tests/run.php",
        "lint": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l"
    }
}
